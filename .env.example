# Copy to .env and fill in. Never commit the real .env.
#
# After the first start, most of this is managed in the web UI instead:
# the Connections page (MQTT broker, database, the device's broker) and
# the Settings page (polling, snapshots, sessions, HTTPS/proxies, audit
# retention, Ollama, log level). Values saved there override these. What
# only lives here: SECRETS_MASTER_KEY, the first-admin pair, the snapshot
# signing key, and what Docker Compose itself reads (APP_PORT, APP_BIND,
# APP_UID/GID, COMPOSE_PROFILES, APP_VERSION).

# MQTT and the database below are the first-start values. After that, an
# admin can change both on the web UI's Connections page (tested before
# saving), which then overrides these (config/connections.yaml).

# MQTT. Normally your central broker: create the two accounts and their
# topic ACLs there first (docs/mqtt-broker.md), then point this at it.
MQTT_HOST=192.0.2.25
MQTT_PORT=1883

# Aggregator (this service)'s account on that broker.
MQTT_USERNAME=bedside-aggregator
MQTT_PASSWORD=changeme-bedside-aggregator
# The bedside device's account. Optional with a central broker: the web
# UI's Connections page -> Bedside device is where it's normally set, and
# the device fetches it from there (GET /device/config). Until then, these
# are what it's handed. Required by the bundled broker below.
# MQTT_CLIENT_USERNAME=bedside-esp32
# MQTT_CLIENT_PASSWORD=changeme-client

# --- OR: the bundled Mosquitto container instead of a central broker ---
# Uncomment both, plus MQTT_CLIENT_* above (and comment out MQTT_HOST
# above). The bundled broker provisions both accounts from these at start.
# Usernames are fixed in mosquitto/config/acl.conf.
# COMPOSE_PROFILES=local-mqtt
# MQTT_HOST=mosquitto
# (Using both bundled services? COMPOSE_PROFILES=local-db,local-mqtt)

# Postgres (users/sessions/audit). Normally your central Postgres server:
# create a dedicated non-superuser role + database there first (SQL in
# docs/database.md), then point DATABASE_URL at it. Use a URL-safe password
# (e.g. `openssl rand -hex 24`), since it's embedded in the URL. The app
# creates/upgrades its own tables on startup.
DATABASE_URL=postgresql+asyncpg://bedside_dashboard:changeme-app-db@db.example.lan:5432/bedside_dashboard

# --- OR: the bundled Postgres container instead of a central server ---
# Uncomment all four. POSTGRES_PASSWORD is its bootstrap superuser (admin
# work only); DB_PASSWORD is the app's restricted role, created once on first
# boot of an empty volume (postgres/initdb.sh) — changing it later needs an
# ALTER ROLE.
# COMPOSE_PROFILES=local-db
# POSTGRES_PASSWORD=changeme-postgres-superuser
# DB_PASSWORD=changeme-app-db
# DATABASE_URL=postgresql+asyncpg://bedside_dashboard:changeme-app-db@postgres:5432/bedside_dashboard

# Home Assistant MQTT discovery prefix (app/device.py); HA reads the central
# broker, so the device's sensors and button triggers appear there directly.
# Blank turns discovery off.
# HA_DISCOVERY_PREFIX=homeassistant

# Web UI login. ADMIN_USERNAME/ADMIN_PASSWORD create the FIRST administrator
# when the users table is empty (min 12 characters); after that they're
# ignored and can be removed — manage users in the app. Leave blank and no
# one can log in, so set both before first start.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Set true when the UI is reached over HTTPS (behind a reverse proxy):
# Secure session cookie + HSTS. Leave false for plain-HTTP LAN access.
HTTPS_ONLY=false
# Comma-separated reverse-proxy IPs whose X-Forwarded-For is trusted (used
# for the audit log and login throttling). Empty = trust none.
TRUSTED_PROXIES=
# Signs the /snapshot links sent to the ESP32. Optional: unset = a random
# key per process (links are short-lived, so a restart costs nothing).
# `openssl rand -hex 32` if you want it stable.
SNAPSHOT_SIGNING_KEY=

# Audit-log rows older than this many days are deleted at startup (0 = keep all).
AUDIT_RETENTION_DAYS=365
# Publish the app port on this host address only (e.g. 127.0.0.1 behind a
# same-host proxy). Default keeps it on the LAN, which the ESP32 needs for
# /snapshot. See docs/reverse-proxy.md before exposing the UI beyond your LAN.
# APP_BIND=0.0.0.0
# Shown in the web UI footer (set by your deploy/CI; "dev" if unset).
# APP_VERSION=dev
# Runs the container as this UID:GID instead of root — set to whoever owns
# /opt/bedside-dashboard-data/config on this host (`id -u` / `id -g`). Defaults
# to 1000:1000, the usual first-user UID on a fresh Linux install.
# APP_UID=1000
# APP_GID=1000

# Aggregator loop timing (seconds)
POLL_INTERVAL_SECONDS=15
HEARTBEAT_INTERVAL_SECONDS=45

# /snapshot/* proxy output size (aspect kept, letterboxed on black). Default
# is landscape to match the ESP32 client's CAMERA screen (same orientation
# as HOME/MENU). Only change this if your display runs a different
# resolution or orientation.
SNAPSHOT_WIDTH=320
SNAPSHOT_HEIGHT=240

LOG_LEVEL=INFO

# Host port for the web UI/API (container listens on 8000). 8001 leaves the
# desk dashboard (8031 on docker-host) alone.
APP_PORT=8001
# Bundled broker only (local-mqtt): its host port. 1884 by default so it
# can't clash with another broker on 1883; the firmware's MQTT_PORT must match.
# MQTT_PUBLISH_PORT=1884

# AI-assisted template generation (app/ai_assist.py) — Ollama running on
# the HOST, not in this compose stack (docker-compose.yml routes
# host.docker.internal to it via extra_hosts). Leave OLLAMA_BASE_URL
# unset/blank to disable the feature entirely (the "Generate" buttons in
# the web UI just fail with a clear message instead of hanging
# against an unreachable default). Pick a model you've confirmed actually
# uses Ollama's real tool-calling contract — verified 2026-09-18 that
# llama3.1:8b and qwen2.5:7b both do; qwen2.5-coder:14b, despite being
# tagged with tool support, did not on that Ollama version. Tested
# 2026-09-23 on a real "keep lines 1-2, add a line 3" request:
# qwen2.5:14b 3/3 correct, llama3.1:8b 0/3 (lost the request and answered
# about something else) — see app/settings.py.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b

# Encrypts per-adapter credentials in config/secrets.enc.yaml (see
# app/secret_store.py). Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored secret unrecoverable — back it up.
SECRETS_MASTER_KEY=
